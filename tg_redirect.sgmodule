#!name=Telegram Redirect
#!desc=Telegram 链接跳转第三方客户端
#!system=ios,mac

[MITM]
hostname = %APPEND% t.me

[Script]
# 下一行代码中，请将 script-path= 后的链接替换为你第一步获取的 Raw 链接
# argument= 后面可以修改为你想要的客户端，例如: Nicegram, iMe, Telegram
Telegram_Redirect = type=http-request, pattern=^https?:\/\/t\.me\/.+, script-path=https://raw.githubusercontent.com/Gin8527/Script/refs/heads/main/tg_redirect.js, argument=Turrit
